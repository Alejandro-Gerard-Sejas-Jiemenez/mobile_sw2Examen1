# Base URL of the security-auditing platform's backend API.
# MUST be HTTPS in any non-local environment (Constitution Principle III).
# Read only via process.env.EXPO_PUBLIC_API_URL in src/services/api/client.ts.
#
# No real backend exists yet — run `npm run mock-server` (see mock-server/index.js) and point
# this at it instead:
#   - Web / iOS simulator:           http://localhost:4000
#   - Android emulator:              http://10.0.2.2:4000
#   - Physical device on same Wi-Fi: http://<your-computer's-LAN-IP>:4000
EXPO_PUBLIC_API_URL=https://api.example.com

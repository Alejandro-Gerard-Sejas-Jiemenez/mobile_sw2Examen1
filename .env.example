# CORE backend (identity + catalog): auth/JWT, users, /software/, monetización.
# Django project "api_backend" (Parcial1Software2). Read via
# process.env.EXPO_PUBLIC_API_URL in src/services/api/client.ts (JWT + refresh).
# MUST be HTTPS in any non-local environment (Constitution Principle III).
#   - Web / iOS simulator:           http://localhost:8000/api
#   - Android emulator:              http://10.0.2.2:8000/api
#   - Physical device on same Wi-Fi: http://<your-computer's-LAN-IP>:8000/api
EXPO_PUBLIC_API_URL=https://api.example.com/api

# INJECTION backend (offensive engine): /descubrimientos/, /ataques/, /ataques/{id}/turnos/,
# /sistema/ollama/. Django project "backend_genvulnai". Read via
# process.env.EXPO_PUBLIC_INJECTION_API_URL in src/services/api/injection-client.ts
# (NO auth — this backend is unauthenticated). Run it on a DIFFERENT port than the
# core backend (both default to 8000): e.g. `python manage.py runserver 0.0.0.0:8010`.
EXPO_PUBLIC_INJECTION_API_URL=https://injection.example.com/api

# MOCK MODE — Injection backend (backend_genvulnai).
# Set to "true" to run the app WITHOUT the injection backend running locally.
# All calls to /descubrimientos/, /ataques/, /sistema/ollama/ etc. return fixture
# data from src/services/api/mock/mock-data.ts instead of hitting the network.
# Leave blank (or "false") for real API calls.
# Useful when the injection backend is too resource-heavy to run on this machine.
EXPO_PUBLIC_MOCK_INJECTION=false
